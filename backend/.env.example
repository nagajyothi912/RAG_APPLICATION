GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
EMBED_MODEL_NAME=all-MiniLM-L6-v2
# fixed | recursive | heading  (see backend/app/services/chunking.py)
CHUNK_STRATEGY=heading
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
TOP_K=5
# Tuned in results.md section 5. In-corpus questions bottom out at 0.187 and out-of-scope
# questions reach 0.310, so the populations overlap: this is the highest value that refuses
# nothing answerable. The system prompt catches what gets past it.
SCORE_THRESHOLD=0.15
DOCS_DIR=data/docs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Week 5 request tracing. Off by default; the test suite and both evaluation
# scripts must be able to run without producing any trace output.
# TRACE_ENABLED=false
# TRACE_PATH=data/traces/chat_traces.jsonl
# TRACE_INCLUDE_PROMPTS=true
# Left unset, the app sends no temperature and Groq uses its own default, which
# is why a live trace is not byte-replayable. The trace-collection run sets 0.
# GROQ_TEMPERATURE=

# Langfuse: a second sink for the same trace record, read at
# https://<your-region>.cloud.langfuse.com. Independent of TRACE_ENABLED.
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=development
