GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
EMBED_MODEL_NAME=all-MiniLM-L6-v2
# fixed | recursive | heading  (see backend/app/services/chunking.py)
CHUNK_STRATEGY=heading
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
TOP_K=5
# Tuned in results.md section 5. In-corpus questions bottom out at 0.187 and out-of-scope
# questions reach 0.310, so the populations overlap: this is the highest value that refuses
# nothing answerable. The system prompt catches what gets past it.
SCORE_THRESHOLD=0.15
DOCS_DIR=data/docs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Week 5 request tracing. Off by default; the test suite and both evaluation
# scripts must be able to run without producing any trace output.
# TRACE_ENABLED=false
# TRACE_PATH=data/traces/chat_traces.jsonl
# TRACE_INCLUDE_PROMPTS=true
# Left unset, the app sends no temperature and Groq uses its own default, which
# is why a live trace is not byte-replayable. The trace-collection run sets 0.
# GROQ_TEMPERATURE=

# Langfuse: a second sink for the same trace record, read at
# https://<your-region>.cloud.langfuse.com. Independent of TRACE_ENABLED.
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=development

# Role-based login. The chatbot account can chat and read the library; the admin
# account also uploads/deletes documents and sees every week's evaluation tab.
# Change both passwords. Leave AUTH_SECRET empty and every restart signs everyone out.
# The web assistant (/api/assistant): help centre + ticket history over MCP.
# Starts its MCP servers with the backend; set false to run without it.
# ASSISTANT_ENABLED=true
# ASSISTANT_MCP_CONFIG=config/mcp_servers.webapp.json
# Empty = GROQ_MODEL. Groq's limits are per model (free tier: 8,000 tokens/minute),
# so a different model here stops the assistant and /api/chat sharing one allowance.
# ASSISTANT_MODEL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
CHATBOT_USERNAME=user
CHATBOT_PASSWORD=user123
AUTH_SECRET=
AUTH_TOKEN_TTL_MINUTES=480
# AUTH_ENABLED=true
